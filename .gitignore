.DS_Store
.idea/
.vscode/
*.swp

# Syncade runtime (kept gitignored per-consumer-repo;
# this repo doesn't generate them, but defensive in case of dev testing)
.syncade/runs/
.syncade/workspace-claims/
.syncade/metrics.db
.syncade/evidence/
.syncade/findings.md
.syncade/clarifications.md
.syncade/last-reviewed.json
.syncade/draft-spec-*.md
.syncade/metrics.db
# NOTE: .syncade/config.toml is intentionally NOT gitignored — that's
# the per-repo config that travels with the project.

# Claude Code harness runtime artifacts (session locks, scheduled-task
# state files, local settings). Created in the developer's working
# tree by Claude Code itself; not produced by syncade and not part of
# the project. The whitelist pattern (ignore-everything-then-allow)
# is required so the in-tree skill bridge under .claude/skills/ can
# escape the ignore — gitignore can't re-include a file once its
# parent dir is ignored, so we ignore individual paths instead.
.claude/*
# Exception: the in-tree Claude Code skill bridge (PR-9 Task 1) lives
# at .claude/skills/syncade/ and IS part of the project. Future PRs
# may extract this to a separate marketplace/distribution repo; until
# then the skill markdown ships in-tree.
!.claude/skills/

# Private-identifier list for the pre-publish leak gate — never tracked.
.private-identifiers
